{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "outDir": "build/js",
    "rootDir": "src",
    "sourceMap": false,
    "removeComments": true,
    "types": []
  },
  "include": ["src/**/*.ts"]
}
