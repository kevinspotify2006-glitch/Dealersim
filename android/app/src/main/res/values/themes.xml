<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Full screen from the first frame: no title, no status bar; the activity then
         switches to sticky immersive mode and hides the navigation bar too. -->
    <style name="Theme.Tycoon" parent="android:Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowBackground">#FF0F1114</item>
        <item name="android:statusBarColor">#FF0F1114</item>
        <item name="android:navigationBarColor">#FF0F1114</item>
    </style>
</resources>
