# Optional. Nothing here is required to build or play the game.

# Port for `npm run dev` / `npm start`
PORT=5173

# APK signing (tools/apk/build_apk.py). If unset, a debug key is created at
# tools/apk/debug.keystore on first build. Use your own key for anything you
# distribute, and keep it safe: updates must be signed with the same key.
CDMT_KEYSTORE=
CDMT_KEY_ALIAS=cdmt
CDMT_KEY_PASSWORD=
